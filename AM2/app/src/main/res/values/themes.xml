<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TIK" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/black</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowTranslucentStatus" tools:targetApi="kitkat">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="lollipop">true</item>

        <!-- Background and Text colors -->
        <item name="android:windowBackground">@color/black</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>

        <!-- Outline and Hint colors (PENTING untuk OutlinedBox) -->
        <item name="colorOutline">@color/white</item>
        <item name="colorOnSurface">@color/white</item>

        <!-- Custom AlertDialog Style -->
        <item name="alertDialogTheme">@style/CustomAlertDialog</item>

        <!-- Transition Animations -->
        <item name="android:windowAnimationStyle">@style/WindowAnimation</item>
    </style>

    <style name="CustomAlertDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/frame_background</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="colorAccent">@color/orange_accent</item>
        <item name="buttonBarPositiveButtonStyle">@style/AlertButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertButtonStyle</item>

        <!-- Penting untuk penanganan dimens lebar dialog -->
        <item name="android:windowMinWidthMajor">@dimen/overlay_dialog_width</item>
        <item name="android:windowMinWidthMinor">@dimen/overlay_dialog_width</item>
    </style>

    <style name="AlertButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/orange_accent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>

    <style name="ShapeAppearance.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>