<resources>
    <string name="app_name">am\u00B2</string>
    <string name="video_live_from">LIVE: %1$s</string>
    <string name="video_private_with">PRIVATE %1$s</string>
    <!--
        Not "remember me". What is kept is a device token the relay issued to
        this handset, which an admin can revoke on its own, so a lost radio is
        a revocation rather than a password change for the person. The label
        says what it buys the operator: the unit signs itself back in after a
        restart instead of waiting for somebody to hold it.
    -->
    <string name="login_stay_signed_in">Tetap masuk di perangkat ini</string>
    <!--
        Named for what it changes. It writes start_on_boot, read only by
        BootReceiver, which decides whether the app comes up when the handset
        powers on. It has never had anything to do with signing in: fc645bb
        separated the two, and a stored session resumes whether this is on or
        off. The old label said "Auto Login" and sent operators looking here
        for the reason their radio would not sign itself back in.
    -->
    <string name="setting_start_on_boot">Jalankan saat perangkat menyala</string>
</resources>