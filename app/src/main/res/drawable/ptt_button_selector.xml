<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- State Talking (TX) - Stroke Merah Tipis Putus-putus Panjang -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#1E1E1E" />
            <stroke
                android:width="2dp"
                android:color="#FF0000"
                android:dashWidth="80dp"
                android:dashGap="15dp" />
        </shape>
    </item>
    <!-- State Receiving (RX) - Stroke Hijau Tipis Putus-putus Panjang -->
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="#1E1E1E" />
            <stroke
                android:width="2dp"
                android:color="#00FF00"
                android:dashWidth="80dp"
                android:dashGap="15dp" />
        </shape>
    </item>
    <!-- Default / Idle State - Stroke Abu-abu Tipis Solid -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1E1E1E" />
            <stroke android:width="1dp" android:color="#888888" />
        </shape>
    </item>
</selector>