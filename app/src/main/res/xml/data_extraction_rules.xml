<?xml version="1.0" encoding="utf-8"?>
<!--
    The same exclusions for cloud backup and for a direct device transfer.

    Both carried the empty Android Studio template with every rule commented
    out, so nothing was excluded from either. Device transfer matters as much
    as backup here: it is the path that moves an operator's radio identity onto
    a different handset without anybody signing in.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="am2_credentials.xml" />
        <exclude domain="file" path="cred.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="am2_credentials.xml" />
        <exclude domain="file" path="cred.txt" />
    </device-transfer>
</data-extraction-rules>
