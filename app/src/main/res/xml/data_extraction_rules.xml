<?xml version="1.0" encoding="utf-8"?>
<!-- Credential material must not enter cloud backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="am2_credentials.xml" />
        <exclude domain="sharedpref" path="AM2_PREFS.xml" />
        <exclude domain="device_sharedpref" path="am2_credentials.xml" />
        <exclude domain="device_sharedpref" path="AM2_PREFS.xml" />
        <exclude domain="file" path="cred.txt" />
        <exclude domain="device_file" path="cred.txt" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="am2_credentials.xml" />
        <exclude domain="sharedpref" path="AM2_PREFS.xml" />
        <exclude domain="device_sharedpref" path="am2_credentials.xml" />
        <exclude domain="device_sharedpref" path="AM2_PREFS.xml" />
        <exclude domain="file" path="cred.txt" />
        <exclude domain="device_file" path="cred.txt" />
    </device-transfer>
</data-extraction-rules>
